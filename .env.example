# ===========================================
# EcoRide — MODÈLE de configuration
# ===========================================
# Ce fichier est un EXEMPLE, sans aucun vrai secret.
# Il est versionné sur GitHub pour montrer quelles variables sont nécessaires.
#
# Pour l'utiliser : copier ce fichier en "backend/.env" puis remplir les vraies valeurs.
#   cp .env.example backend/.env
# ===========================================

# --- Serveur ---
# Port d'écoute en local. Sur Render, la plateforme impose son propre port.
PORT=3000

# Adresse du site front autorisée à appeler l'API (sécurité CORS)
FRONTEND_URL=https://ecoride2.netlify.app

# --- Base de données relationnelle : Supabase (PostgreSQL) ---
# Dashboard Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=colle_ici_ta_cle_service_role

# --- Base de données NoSQL : MongoDB Atlas ---
# Dashboard Atlas > Database > Connect > Drivers
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/ecoride

# --- Sécurité des connexions (JWT) ---
# Longue phrase secrète aléatoire. Sert à signer les jetons de connexion.
# En générer une avec :  openssl rand -base64 48
JWT_SECRET=remplace_par_une_longue_phrase_aleatoire

# --- Envoi d'e-mails (Nodemailer) — US 10 et US 11 ---
#
# SI TU LAISSES CES LIGNES VIDES : l'application crée toute seule un compte
# de test chez Ethereal. Les mails ne partent chez personne, mais un LIEN
# s'affiche dans la console du serveur ET dans la page, pour les lire dans
# le navigateur. C'est idéal pour montrer les mails pendant la soutenance.
#
# SI TU LES REMPLIS : les mails partent pour de vrai.
# Pour Gmail, il faut un "mot de passe d'application"
# (myaccount.google.com/apppasswords), pas ton mot de passe habituel.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
